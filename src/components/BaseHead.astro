---
import '@/styles/index.css'
import {site} from "@/consts";
import UmamiAnalytics from '@/components/UmamiAnalytics.astro';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import BusuanziAnalytics from '@/components/BusuanziAnalytics.astro';
import getUrl from "@/utils/getUrl";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const {
  title,
  description = site.description,
  mathjax = false,
  mermaid = false,
  ogImage: ogImageProp = '',
  ogImageAlt = site.title,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = site.author,
} = Astro.props;

const resolveAbsoluteUrl = (value: string) => new URL(value, Astro.site).toString();
const toIsoString = (value: string | Date | undefined) => {
  if (!value) return '';

  const resolvedDate = value instanceof Date ? value : new Date(value);
  return Number.isNaN(resolvedDate.getTime()) ? '' : resolvedDate.toISOString();
};

const pageTitle = title ? `${title} - ${site.title}` : site.title;
const ogImage = ogImageProp
  ? resolveAbsoluteUrl(ogImageProp)
  : resolveAbsoluteUrl(site.avatar);
const articlePublishedTime = toIsoString(publishedTime);
const articleModifiedTime = toIsoString(modifiedTime);
---
<head>
  <!-- Global Metadata -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" type="image/svg+xml" href={getUrl(site.favicon)}>
  <meta name="generator" content={Astro.generator}>
  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL}>
  <link rel="alternate" type="application/rss+xml" title={site.title} href={getUrl('/rss.xml')}>
  <link
    rel="preload"
    href={getUrl('/fonts/JetBrainsMono-Regular.woff2')}
    as="font"
    type="font/woff2"
    crossorigin
  >

  <!-- Primary Meta Tags -->
  <meta name="title" content={pageTitle}>
  <meta name="description" content={description}>
  <meta name="author" content={author}>
  <meta name="robots" content="index,follow">
  <meta name="color-scheme" content="light dark">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="og:site_name" content={site.title}>
  {
    type === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )
  }
  {
    type === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )
  }
  {
    type === 'article' && author && (
      <meta property="article:author" content={author} />
    )
  }

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={pageTitle}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={ogImage}>
  <meta property="twitter:image:alt" content={ogImageAlt}>

  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="msapplication-TileColor" content="#da532c">
  <meta name="theme-color" content="#ffffff">

  <link rel="sitemap" href={getUrl("/sitemap-index.xml")}>
  <title>{pageTitle}</title>
  <script is:inline src={getUrl("/toggle-theme.js")}></script>
  {
    mathjax && <script is:inline async type="text/javascript" src=`${getUrl("/load-mathjax.js")}`></script>
  }

  {
    mermaid &&
    <script is:inline async type="text/javascript" src="https://cdn.bootcdn.net/ajax/libs/mermaid/10.9.0/mermaid.min.js"></script>
  }
  <GoogleAnalytics />
  <UmamiAnalytics />
  <BusuanziAnalytics/>
</head>
