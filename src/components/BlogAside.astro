---
import CommentAside from "@/components/CommentAside.astro";
import {comment} from "@/consts";
import {getCollectionByName} from "@/utils/getCollectionByName";
import getCountByCategory from "@/utils/getCountByCategory";
import getCountByTagName from "@/utils/getCountByTagName";
import {site} from '@/consts'
import {t} from '@/i18n/utils'
import getUrl from "@/utils/getUrl";
import {getVisibleInterviewEntries, getInterviewPath, isInterviewIndexEntry} from "@/utils/interview";
import {execFileSync} from "node:child_process";
import {statSync} from "node:fs";
import {join} from "node:path";

const blogs = await getCollectionByName('blog')
const feeds = await getCollectionByName('feed')
const wikiEntries = (await getVisibleInterviewEntries()).filter((entry) => !isInterviewIndexEntry(entry));
const MAX_VISIBLE_TAGS = 16;

const sortTaxonomyEntries = (entries: [string, number][]) =>
  entries.sort(([nameA, countA], [nameB, countB]) => {
    if (nameA === 'uncategorized') return 1;
    if (nameB === 'uncategorized') return -1;
    return countB - countA || nameA.localeCompare(nameB);
  });

const categoryCount = getCountByCategory(blogs);
const tagCount = getCountByTagName(blogs);
const sortedCategories = sortTaxonomyEntries(
  Object.entries(categoryCount) as [string, number][]
);
const sortedTags = sortTaxonomyEntries(
  Object.entries(tagCount) as [string, number][]
);
const visibleCategories = sortedCategories.slice(0, 8);
const hasMoreCategories = sortedCategories.length > visibleCategories.length;
const visibleTagSize = site.asideTagsMaxSize > 0
  ? Math.min(site.asideTagsMaxSize, MAX_VISIBLE_TAGS)
  : MAX_VISIBLE_TAGS;
const visibleTags = sortedTags.slice(0, visibleTagSize);
const hasMoreTags = sortedTags.length > visibleTags.length;

const getBlogUpdatedAt = (blog: typeof blogs[number]) => {
  return new Date(blog.data.lastModified || blog.data.date || 0);
};

const wikiUpdateCache = ((globalThis as typeof globalThis & {
  __wikiUpdateCache?: Map<string, number>;
}).__wikiUpdateCache ??= new Map<string, number>());

const getWikiUpdatedAt = (entry: typeof wikiEntries[number]) => {
  const cachedTime = wikiUpdateCache.get(entry.id);
  if (cachedTime) {
    return new Date(cachedTime);
  }

  const relativePath = join('src/content/interview', entry.id);
  let updatedAt = new Date(0);

  try {
    const gitDate = execFileSync('git', ['log', '-1', '--format=%cI', '--', relativePath], {
      cwd: process.cwd(),
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();

    if (gitDate) {
      updatedAt = new Date(gitDate);
    }
  } catch {
    // Fall back to filesystem metadata outside a git checkout.
  }

  if (updatedAt.getTime() === 0) {
    try {
      updatedAt = statSync(join(process.cwd(), relativePath)).mtime;
    } catch {
      updatedAt = new Date(0);
    }
  }

  wikiUpdateCache.set(entry.id, updatedAt.getTime());
  return updatedAt;
};

const formatRecentDate = (date: Date) => {
  return date.toLocaleDateString('zh-CN', {
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '-');
};

const getFeedTitle = (feed: typeof feeds[number]) => {
  if (feed.data.title) {
    return feed.data.title;
  }

  return feed.body
    .split(/\r?\n/)
    .map((line) => line.trim())
    .find(Boolean) || '动态';
};

const recentUpdates = [
  ...blogs.map((blog) => ({
    href: getUrl("/blog/") + blog.slug,
    title: blog.data.title,
    type: 'Blog',
    updatedAt: getBlogUpdatedAt(blog),
  })),
  ...wikiEntries.map((entry) => ({
    href: getUrl(getInterviewPath(entry)),
    title: entry.data.title,
    type: 'Wiki',
    updatedAt: getWikiUpdatedAt(entry),
  })),
  ...feeds.map((feed) => ({
    href: getUrl("/feed/") + feed.slug,
    title: getFeedTitle(feed),
    type: '动态',
    updatedAt: new Date(feed.data.date || 0),
  })),
]
  .filter((item) => item.updatedAt.getTime() > 0)
  .sort((a, b) => b.updatedAt.getTime() - a.updatedAt.getTime())
  .slice(0, site.recentBlogSize);
---

<details class="aside-section aside-section-recent aside-group" open>
  <summary class="aside-widget aside-summary">
    <div class="aside-widget-title">
      <i class="ri-time-line menu-icon"></i> {t('sidebar.recentArticle')}
    </div>
    <i class="ri-arrow-down-s-line aside-summary-icon"></i>
  </summary>
  <div class="aside-group-content recent-article-list flex flex-col">
    {
      recentUpdates.map((item) => (
        <a
          href={item.href}
          class="recent-article-link"
          title={item.title}
        >
          <span class="recent-article-title">{item.title}</span>
          <span class="recent-article-meta">
            <span class="recent-article-type">{item.type}</span>
            <span class="recent-article-date">{formatRecentDate(item.updatedAt)}</span>
          </span>
        </a>
      ))
    }
  </div>
</details>

{
  sortedCategories.length > 0 && (
    <details class="aside-section aside-section-plain aside-group" open>
      <summary class="aside-widget aside-summary">
        <div class="aside-widget-title">
          <i class="ri-folder-3-line menu-icon"/>{t('sidebar.categories')}
        </div>
        <i class="ri-arrow-down-s-line aside-summary-icon"></i>
      </summary>
      <div class="aside-group-content aside-category-grid">
        {
          visibleCategories.map(([category, count]) => (
            <a
              class="aside-link aside-category-link"
              title={category + " (" + count + ")"}
              href={getUrl("/category/") + category}
            >
              <span class="aside-link-label">{category === 'uncategorized' ? t('sidebar.uncategorized') : category}</span>
              <span class="aside-link-count">{count}</span>
            </a>
          ))
        }
        {
          hasMoreCategories && (
            <a class="aside-link aside-link-more aside-more-row" title={t('more')} href={getUrl("/category")}>
              <span class="aside-link-label">{t('more')}</span>
              <span class="aside-link-count">»</span>
            </a>
          )
        }
      </div>
    </details>
  )
}

{
  visibleTags.length > 0 && (
    <details class="aside-section aside-section-plain aside-group">
      <summary class="aside-widget aside-summary">
        <div class="aside-widget-title">
          <i class="ri-hashtag menu-icon"/>
          {t('sidebar.tags')}
        </div>
        <i class="ri-arrow-down-s-line aside-summary-icon"></i>
      </summary>
      <div class="aside-group-content flex flex-wrap gap-2">
        {
          visibleTags.map(([tag, count]) =>
            <a
              class="aside-tag inline-block truncate"
              title={tag + " (" + count + ")"}
              href={getUrl("/tags/") + tag}
            >
              {tag}
            </a>
          )
        }
        {
          hasMoreTags &&
          (
            <a class="aside-link aside-link-more aside-more-row" title={t('more')} href={getUrl("/tags")}>
              <span class="aside-link-label">{t('more')}</span>
              <span class="aside-link-count">»</span>
            </a>
          )
        }
      </div>
    </details>
  )
}

{comment.enable && comment.type === "waline" && <CommentAside/>}
