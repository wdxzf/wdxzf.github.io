---
import { t } from '@/i18n/utils';
import { formatDate } from '@/utils/formatDate';
import getUrl from '@/utils/getUrl';
import type { BlogEntry } from '@/types/content';

const {
  posts = [],
  currentSlug = '',
} = Astro.props as {
  posts?: BlogEntry[];
  currentSlug?: string;
};

const currentPost = posts.find((post) => post.slug === currentSlug);
const seriesName = currentPost?.data.series ?? posts[0]?.data.series ?? '';
---

{
  posts.length > 1 && (
    <section class="mt-8">
      <div class="aside-widget">
        <div class="flex items-center gap-3">
          <i class="ri-book-open-line menu-icon" />
          <div class="min-w-0 flex-1 truncate">
            <span>{t('post.series')}</span>
            {seriesName && <span>{` · ${seriesName}`}</span>}
            <span class="text-skin-dodge">
              {`（${posts.length}${t('post.seriesCountSuffix')}）`}
            </span>
          </div>
        </div>
      </div>
      <div class="space-y-3">
        {posts.map((post: BlogEntry, index: number) => {
          const isCurrent = post.slug === currentSlug;

          return (
            <a
              href={getUrl('/blog/') + post.slug}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'related-post-card flex items-start gap-4 rounded-lg p-4',
                isCurrent && 'border border-skin-active',
              ]}
            >
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-skin-card text-sm font-bold text-skin-base">
                {post.data.seriesOrder ?? index + 1}
              </div>
              <div class="min-w-0 flex-1">
                <div class="mb-1 flex items-center gap-2">
                  <div class="truncate text-lg font-bold leading-snug text-skin-base">
                    {post.data.title}
                  </div>
                  {isCurrent && (
                    <span class="shrink-0 rounded bg-skin-card px-2 py-0.5 text-xs text-skin-dodge">
                      {t('post.seriesCurrent')}
                    </span>
                  )}
                </div>
                <div class="text-sm text-skin-dodge">
                  <i class="ri-calendar-2-fill mr-1" />
                  {formatDate(post.data.date)}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )
}
