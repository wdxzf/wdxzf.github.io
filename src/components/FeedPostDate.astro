---
import {config} from "../consts";
import {t} from '../i18n/utils'
import {formatDate} from "@/utils/formatDate";
const { date, index } = Astro.props;
const fallbackDate = formatDate(date);
---

<feed-post-date
  class={date ? "mr-2" : ""}
  data-date={date}
  data-index={index}
  data-lang={config.lang || 'en'}
  data-published-label={t('feed.publishedIn')}
>
  <span class="postTimeEle">{fallbackDate || date || ''}</span>
</feed-post-date>

<script>
  class FeedPostDate extends HTMLElement {
    connectedCallback() {
      const date = this.dataset.date;
      const lang = this.dataset.lang || 'en';
      const publishedLabel = this.dataset.publishedLabel || '';
      const timeSpan = this.querySelector<HTMLElement>(".postTimeEle");

      if (!timeSpan || !date) {
        return;
      }

      timeSpan.textContent = `${publishedLabel}：${formatRelativeTime(date, lang)}`;
    }
  }

  function formatRelativeTime(dateString: string, locale: string) {
    const targetDate = new Date(dateString);
    if (Number.isNaN(targetDate.getTime())) {
      return dateString;
    }

    const diffMs = targetDate.getTime() - Date.now();
    const diffMinutes = Math.round(diffMs / (1000 * 60));
    const diffHours = Math.round(diffMinutes / 60);
    const diffDays = Math.round(diffHours / 24);
    const diffMonths = Math.round(diffDays / 30);
    const diffYears = Math.round(diffDays / 365);
    const formatter = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' });

    if (Math.abs(diffMinutes) < 60) {
      return formatter.format(diffMinutes, 'minute');
    }

    if (Math.abs(diffHours) < 24) {
      return formatter.format(diffHours, 'hour');
    }

    if (Math.abs(diffDays) < 30) {
      return formatter.format(diffDays, 'day');
    }

    if (Math.abs(diffMonths) < 12) {
      return formatter.format(diffMonths, 'month');
    }

    return formatter.format(diffYears, 'year');
  }

  if (!customElements.get("feed-post-date")) {
    customElements.define("feed-post-date", FeedPostDate);
  }
</script>
