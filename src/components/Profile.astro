---
import {site, infoLinks} from "@/consts";
import getUrl from "@/utils/getUrl";
const activeInfoLinks = infoLinks.filter((infoItem) => infoItem.outlink);
---

<div class="shadow-lg rounded-lg w-auto flex flex-col items-center justify-center bg-skin-card px-4 py-6">
  <img class="avatar mb-4" src={site.avatar.startsWith('http') ? site.avatar : getUrl(site.avatar)} alt="avatar"/>
    <div class="mb-2 text-center">{site.motto}</div>
  <div class="social-links-row">
    {
      activeInfoLinks.map((infoItem) => (
        <a
          class="social-link"
          aria-label={infoItem.name}
          href={infoItem.outlink}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class={infoItem.icon + " social-link-icon"}/>
          <span class="social-link-tooltip">{infoItem.name}</span>
        </a>
      ))
    }
  </div>
</div>
