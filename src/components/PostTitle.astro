---
import dayjs from "dayjs";
import {formatDate} from "@/utils/formatDate";
import {dealLabel} from "@/utils/dealLabel";
import {t} from '@/i18n/utils'
import getUrl from "@/utils/getUrl";
const {title, date, category, tags, lastModified = '', draft = false, readingTime = {}} = Astro.props
const publishDateLabel = formatDate(date);
const lastModifiedLabel = lastModified ? formatDate(lastModified) : '';
const mostRecent = lastModifiedLabel || publishDateLabel;
const mostRecentDate = dayjs(mostRecent);
const currentDate = dayjs();
const shouldShowLastModified = Boolean(lastModifiedLabel) && lastModifiedLabel !== publishDateLabel;
const categoryLabels = category
  ? dealLabel(category).filter((item) => item !== 'uncategorized')
  : [];
const tagLabels = tags ? dealLabel(tags).filter(Boolean) : [];
const showReadingTime = Boolean(readingTime.minutes) && readingTime.minutes !== 0;
const showWordCount = Boolean(readingTime.words);
---

<div class="text-center">
  <!-- title -->
  <h1 class="break-all text-2xl font-bold text-center">{title}</h1>

  <div class="post-meta-row flex flex-wrap items-center justify-center gap-y-1 my-2 text-skin-dodge">
    <!-- date -->
    {
      date &&
      <div class="post-meta-group"><i class="ri-calendar-2-fill mr-1"/>{publishDateLabel}</div>
    }

    {
      shouldShowLastModified &&
      <>
        {(date) && <span class="post-meta-divider" aria-hidden="true">|</span>}
        <div class="post-meta-group"><i class="ri-history-line mr-1"/>{t('post.lastUpdated')}：{lastModifiedLabel}</div>
      </>
    }

    <!-- draft -->
    {
      draft &&
      <>
        {(date || shouldShowLastModified) && <span class="post-meta-divider" aria-hidden="true">|</span>}
        <div class="post-meta-group"><i class="ri-git-pr-draft-line mr-1"/>{t('title.draft')}</div>
      </>
    }

    <!-- category -->
    {
      categoryLabels.length > 0 && (
        <>
          {(date || shouldShowLastModified || draft) && <span class="post-meta-divider" aria-hidden="true">|</span>}
          <div class="post-meta-group">
            <i class="ri-folder-3-line mr-1"/>
            {
              categoryLabels.map((categoryName, index) => (
                <>
                  {index > 0 && <span class="post-meta-inline-divider" aria-hidden="true">, </span>}
                  <a href={getUrl("/category/") + categoryName} class="post-meta-link text-wrap break-all hover:text-skin-active">
                    {categoryName}
                  </a>
                </>
              ))
            }
          </div>
        </>
      )
    }

    <!-- tag -->
    {
      tagLabels.length > 0 && (
        <>
          {(date || shouldShowLastModified || draft || categoryLabels.length > 0) && <span class="post-meta-divider" aria-hidden="true">|</span>}
          <div class="post-meta-group">
            <i class="ri-hashtag mr-1"/>
            {
              tagLabels.map((tagName, index) => (
                <>
                  {index > 0 && <span class="post-meta-inline-divider" aria-hidden="true">, </span>}
                  <a href={getUrl("/tags/") + tagName} class="post-meta-link text-wrap break-all hover:text-skin-active">
                    {tagName}
                  </a>
                </>
              ))
            }
          </div>
        </>
      )
    }

    <!-- minutes -->
    {
      showReadingTime && (
        <>
          {(date || shouldShowLastModified || draft || categoryLabels.length > 0 || tagLabels.length > 0) && <span class="post-meta-divider" aria-hidden="true">|</span>}
          <div class="post-meta-group"><i class="ri-hourglass-fill mr-1"/>{Math.ceil(readingTime.minutes)}{t('title.minutes')}</div>
        </>
      )
    }
    {
      showWordCount && (
        <>
          {(date || shouldShowLastModified || draft || categoryLabels.length > 0 || tagLabels.length > 0 || showReadingTime) && <span class="post-meta-divider" aria-hidden="true">|</span>}
          <div class="post-meta-group"><i class="ri-quill-pen-line mr-1"></i>{readingTime.words}{t('title.words')}</div>
        </>
      )
    }
  </div>
  {
    mostRecent && currentDate.isAfter(mostRecentDate.add(6, 'month')) &&
    <div class="shadow w-fit max-w-full mx-auto flex bg-skin-card p-2 rounded text-sm"><i class="ri-error-warning-line mr-1"/>{t('post.lastUpdatedTip1')} {formatDate(mostRecent)} {t('post.lastUpdatedTip2')} </div>
  }
</div>
