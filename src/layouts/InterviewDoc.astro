---
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import InterviewSidebar from '@/components/InterviewSidebar.astro';
import InterviewToc from '@/components/InterviewToc.astro';
import MobileToc from '@/components/MobileToc.astro';
import ScrollToTop from '@/components/ScrollToTop.astro';
import { ClientRouter } from 'astro:transitions';
import { config } from '@/consts';
import type { MarkdownHeading } from 'astro';
import '@fancyapps/ui/dist/fancybox/fancybox.css';

const {
  frontmatter,
  headings = [],
  currentPath,
} = Astro.props as {
  frontmatter: {
    title: string;
    description?: string | null;
  };
  headings?: MarkdownHeading[];
  currentPath: string;
};

const hasToc = headings.some((item) => item.depth === 2 || item.depth === 3);
const interviewLayoutClass = hasToc
  ? 'grid-cols-1 lg:grid-cols-[17.5rem_minmax(0,1fr)] xl:grid-cols-[17.5rem_minmax(0,820px)_13.75rem]'
  : 'grid-cols-1 lg:grid-cols-[17.5rem_minmax(0,1fr)] xl:grid-cols-[17.5rem_minmax(0,860px)]';
---

<html lang={config.lang}>
  <BaseHead title={frontmatter.title} description={frontmatter.description ?? undefined} />
  <ClientRouter />

  <body class="bg-skin-secondary">
    <Header />
    <main class="relative mx-auto min-h-full max-w-[1380px] px-4 pt-20 pb-32 text-skin-base md:px-6" id="app">
      <div
        id="interview-layout"
        data-has-toc={String(hasToc)}
        class:list={['interview-layout grid gap-6 lg:gap-0', interviewLayoutClass]}
      >
        <div class="hidden border-r border-[rgba(var(--color-text),0.08)] pr-4 lg:block">
          <div class="sticky top-20">
            <InterviewSidebar currentPath={currentPath} />
          </div>
        </div>

        <div class="min-w-0 lg:px-8 xl:px-10">
          <slot />
        </div>

        {
          hasToc && (
            <div class="relative hidden border-l border-[rgba(var(--color-text),0.08)] pl-6 xl:block">
              <InterviewToc headings={headings} />
            </div>
          )
        }

        {hasToc && <MobileToc headings={headings} />}
        <ScrollToTop />
      </div>
      <Footer />
    </main>
  </body>
</html>

<style>
  @media (min-width: 1024px) {
    .interview-layout {
      transition: grid-template-columns 0.2s ease;
    }

    .interview-layout.interview-sidebar-collapsed {
      grid-template-columns: 3rem minmax(0, 1fr) !important;
    }
  }

  @media (min-width: 1280px) {
    .interview-layout[data-has-toc='true'].interview-sidebar-collapsed {
      grid-template-columns: 3rem minmax(0, 820px) 13.75rem !important;
    }
  }
</style>

<script>
  const INTERVIEW_SIDEBAR_COLLAPSED_KEY = 'interview-sidebar-collapsed';

  const initializeInterviewSidebarCollapse = () => {
    const layout = document.querySelector<HTMLElement>('#interview-layout');
    const toggle = document.querySelector<HTMLButtonElement>('#interview-sidebar-toggle');

    if (!layout || !toggle) {
      return;
    }

    const setCollapsed = (collapsed: boolean) => {
      layout.classList.toggle('interview-sidebar-collapsed', collapsed);
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.setAttribute('title', collapsed ? '展开左侧索引' : '收起左侧索引');
      toggle.setAttribute('aria-label', collapsed ? '展开左侧索引' : '收起左侧索引');

      try {
        localStorage.setItem(INTERVIEW_SIDEBAR_COLLAPSED_KEY, String(collapsed));
      } catch {
        // Ignore storage failures and keep the toggle usable.
      }

      if (!collapsed) {
        document.dispatchEvent(new CustomEvent('interview-sidebar:expanded'));
      }
    };

    let shouldCollapse = false;
    try {
      shouldCollapse = localStorage.getItem(INTERVIEW_SIDEBAR_COLLAPSED_KEY) === 'true';
    } catch {
      shouldCollapse = false;
    }

    setCollapsed(shouldCollapse);

    if (toggle.dataset.collapseReady !== 'true') {
      toggle.dataset.collapseReady = 'true';
      toggle.addEventListener('click', () => {
        setCollapsed(!layout.classList.contains('interview-sidebar-collapsed'));
      });
    }
  };

  document.addEventListener('astro:page-load', initializeInterviewSidebarCollapse);
  initializeInterviewSidebarCollapse();

  const shouldDecorateExternalLink = (link: HTMLAnchorElement) => {
    const href = link.getAttribute('href');

    if (
      !href ||
      href.startsWith('#') ||
      href.startsWith('mailto:') ||
      href.startsWith('tel:')
    ) {
      return false;
    }

    const resolvedUrl = new URL(href, window.location.href);
    return resolvedUrl.origin !== window.location.origin;
  };

  const initializeLightbox = async () => {
    try {
      const { Fancybox } = await import('@fancyapps/ui/dist/fancybox/fancybox.esm.js');
      Fancybox.bind('[data-fancybox]');
    } catch (error) {
      console.error('Failed to initialize Fancybox.', error);
    }
  };

  const markdownBody = document.querySelector('.markdown-body');
  if (markdownBody) {
    const images = markdownBody.querySelectorAll<HTMLImageElement>('img');
    images.forEach((image) => {
      const imageSource = image.getAttribute('src');
      if (!imageSource) {
        return;
      }

      const imageParent = image.parentElement;
      if (imageParent?.tagName === 'A') {
        const anchor = imageParent as HTMLAnchorElement;
        anchor.href = anchor.getAttribute('href') || imageSource;
        anchor.setAttribute('data-fancybox', 'gallery');
        if (image.alt) {
          anchor.setAttribute('data-caption', image.alt);
        }
        return;
      }

      const anchor = document.createElement('a');
      anchor.href = imageSource;
      anchor.setAttribute('data-fancybox', 'gallery');
      if (image.alt) {
        anchor.setAttribute('data-caption', image.alt);
      }

      image.replaceWith(anchor);
      anchor.appendChild(image);
    });

    if (images.length > 0) {
      initializeLightbox();
    }

    const links = markdownBody.querySelectorAll<HTMLAnchorElement>('a');
    for (const link of links) {
      const names = link.getAttributeNames();
      if (
        !names.includes('data-footnote-backref') &&
        !names.includes('data-footnote-ref') &&
        shouldDecorateExternalLink(link)
      ) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'nofollow noopener noreferrer');
      }
    }

    const spoilers = markdownBody.querySelectorAll<HTMLElement>('[data-spoiler]');
    const setSpoilerState = (element: HTMLElement, revealed: boolean) => {
      element.setAttribute('data-revealed', String(revealed));
      element.setAttribute('aria-pressed', String(revealed));
    };

    spoilers.forEach((spoiler) => {
      setSpoilerState(spoiler, spoiler.getAttribute('data-revealed') === 'true');

      spoiler.addEventListener('click', () => {
        setSpoilerState(spoiler, spoiler.getAttribute('data-revealed') !== 'true');
      });

      spoiler.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          setSpoilerState(spoiler, spoiler.getAttribute('data-revealed') !== 'true');
        }

        if (event.key === 'Escape') {
          setSpoilerState(spoiler, false);
          spoiler.blur();
        }
      });
    });
  }
</script>
