---
import {getCollectionByName} from "@/utils/getCollectionByName";
import getCountByCategory from "@/utils/getCountByCategory";
import HeaderLink from './HeaderLink.astro';
import ThemeIcon from './ThemeIcon.astro'
import MenuIcon from './MenuIcon.astro'
import {site, categories, infoLinks} from '@/consts';
import {t} from "@/i18n/utils";
import getCountByTagName from "@/utils/getCountByTagName";
import getUrl from "@/utils/getUrl";
const blogs = await getCollectionByName('blog')
let categoryCount = getCountByCategory(blogs);
let tagCount = getCountByTagName(blogs);
const activeInfoLinks = infoLinks.filter((infoItem) => infoItem.outlink);

const sortTaxonomyEntries = (entries: [string, number][]) =>
  entries.sort(([nameA, countA], [nameB, countB]) => {
    if (nameA === 'uncategorized') return 1;
    if (nameB === 'uncategorized') return -1;
    return countB - countA || nameA.localeCompare(nameB);
  });

const sortedMobileCategories = sortTaxonomyEntries(
  Object.entries(categoryCount) as [string, number][]
);
const sortedMobileTags = sortTaxonomyEntries(
  Object.entries(tagCount) as [string, number][]
);

const visibleMobileCategories =
  site.mobileMenuCategoryMaxSize > 0
    ? sortedMobileCategories.slice(0, site.mobileMenuCategoryMaxSize)
    : sortedMobileCategories;
const visibleMobileTags =
  site.mobileMenuTagMaxSize > 0
    ? sortedMobileTags.slice(0, site.mobileMenuTagMaxSize)
    : sortedMobileTags;

const hasMoreMobileCategories =
  site.mobileMenuCategoryMaxSize > 0 &&
  sortedMobileCategories.length > site.mobileMenuCategoryMaxSize;
const hasMoreMobileTags =
  site.mobileMenuTagMaxSize > 0 &&
  sortedMobileTags.length > site.mobileMenuTagMaxSize;

const getPrimarySegment = (value: string) => value.split('/').filter(Boolean)[0] || '';
const currentSegment = getPrimarySegment(Astro.url.pathname);
const isChildGroupActive = (items: { href: string }[]) =>
  items.some((item) => getPrimarySegment(item.href) === currentSegment);
---

<header class="fixed top-0 z-10 w-full bg-skin-fill text-skin-base">
  <div class="container flex items-center justify-between">
    <div class="block xl:hidden">
      <MenuIcon></MenuIcon>
    </div>
    <a class="p-4 text-2xl" href={getUrl("/")}>{site.title}</a>
    <div class="flex items-center">
      <div class="hidden xl:block">
        <div class="flex items-center pr-4 space-x-5">
          {
            categories.map(category => (
              <HeaderLink href={category.href} icon={category.iconClass} target={category.target ? category.target : '_self'} items={category.children ? category.children : []}>{category.name}</HeaderLink>
            ))
          }
        </div>
      </div>
      <ThemeIcon></ThemeIcon>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="mobile-drawer hidden xl:hidden"
    style="height: calc(100vh - 64px)"
  >
    <div class="container mobile-drawer-content space-y-5 px-4 py-5">
      <section class="mobile-drawer-card">
        <img class="mx-auto avatar mb-4" src={site.avatar.startsWith('http') ? site.avatar : getUrl(site.avatar)} alt="avatar"/>
        <div class="mb-3 text-center text-sm text-skin-dodge">{site.motto}</div>
        <div class="social-links-row">
          {
            activeInfoLinks.map((infoItem) => (
              <a
                class="social-link"
                aria-label={infoItem.name}
                href={infoItem.outlink}
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class={infoItem.icon + " social-link-icon"}/>
                <span class="social-link-tooltip">{infoItem.name}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="mobile-drawer-card">
        <div class="mobile-drawer-section-title">
          <i class="ri-compass-3-line menu-icon"></i>
          <span>导航</span>
        </div>
        <div class="space-y-2">
          {
            categories.map((category) => {
              const hasChildren = !!(category.children && category.children.length > 0);

              if (!hasChildren) {
                return (
                  <div class="mobile-drawer-section">
                    <a class="mobile-drawer-link" href={getUrl(category.href)}>
                      <span class="inline-flex items-center gap-2">
                        <i class={category.iconClass}/>
                        <span>{category.name}</span>
                      </span>
                    </a>
                  </div>
                );
              }

              return (
                <div class="mobile-drawer-section">
                  <details class="mobile-drawer-details mobile-drawer-nav-group" open={isChildGroupActive(category.children || [])}>
                    <summary class="mobile-drawer-link mobile-drawer-summary mobile-drawer-nav-trigger">
                      <span class="inline-flex items-center gap-2">
                        <i class={category.iconClass}/>
                        <span>{category.name}</span>
                      </span>
                      <i class="ri-arrow-down-s-line mobile-drawer-summary-icon"></i>
                    </summary>
                    <div class="mobile-drawer-nav-children mt-2 grid gap-2 pl-4 text-sm text-skin-dodge">
                      {
                        category.children?.map((sub) => (
                          <a class="mobile-drawer-sublink" href={getUrl(sub.href)}>
                            <span class="inline-flex items-center gap-2">
                              <i class={sub.iconClass}/>
                              <span>{sub.name}</span>
                            </span>
                          </a>
                        ))
                      }
                    </div>
                  </details>
                </div>
              );
            })
          }
        </div>
      </section>

      <section class="mobile-drawer-card">
        <details class="mobile-drawer-details" open>
          <summary class="mobile-drawer-summary">
            <span class="inline-flex items-center gap-2">
              <i class="ri-folder-3-line menu-icon"></i>
              <span>{t('sidebar.categories')}</span>
            </span>
            <i class="ri-arrow-down-s-line mobile-drawer-summary-icon"></i>
          </summary>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              visibleMobileCategories.map(([category, count]) => (
                <a
                  class="aside-tag"
                  title={(category === 'uncategorized' ? t('sidebar.uncategorized') : category) + " (" + count + ")"}
                  href={getUrl("/category/") + category}
                >
                  {(category === 'uncategorized' ? t('sidebar.uncategorized') : category) + " (" + count + ")"}
                </a>
              ))
            }
          </div>
          {
            hasMoreMobileCategories && (
              <div class="mt-3">
                <a class="text-sm hover:text-skin-active" href={getUrl("/category")}>
                  {t('sidebar.allCategories')} »
                </a>
              </div>
            )
          }
        </details>
        <div class="divider-horizontal-mini"></div>
        <details class="mobile-drawer-details" open>
          <summary class="mobile-drawer-summary">
            <span class="inline-flex items-center gap-2">
              <i class="ri-price-tag-3-line menu-icon"></i>
              <span>{t('sidebar.tags')}</span>
            </span>
            <i class="ri-arrow-down-s-line mobile-drawer-summary-icon"></i>
          </summary>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              visibleMobileTags.map(([tag, count]) => (
                <a class="aside-tag" title={tag + " (" + count + ")"} href={getUrl("/tags/") + tag}>
                  {tag + " (" + count + ")"}
                </a>
              ))
            }
          </div>
          {
            hasMoreMobileTags && (
              <div class="mt-3">
                <a class="text-sm hover:text-skin-active" href={getUrl("/tags")}>
                  {t('sidebar.allTags')} »
                </a>
              </div>
            )
          }
        </details>
      </section>
    </div>
  </div>
</header>

<script>
  const headerNavGroups = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.header-nav-group')
  );

  const closeHeaderNavGroup = (group: HTMLDetailsElement) => {
    group.open = false;
  };

  headerNavGroups.forEach((group) => {
    group.addEventListener('toggle', () => {
      if (!group.open) {
        return;
      }

      headerNavGroups.forEach((otherGroup) => {
        if (otherGroup !== group) {
          closeHeaderNavGroup(otherGroup);
        }
      });
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;

    headerNavGroups.forEach((group) => {
      if (!target || !group.contains(target)) {
        closeHeaderNavGroup(group);
      }
    });
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      headerNavGroups.forEach(closeHeaderNavGroup);
    }
  });
</script>
