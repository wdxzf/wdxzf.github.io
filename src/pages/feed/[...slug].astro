---
import {sortPostsByDate} from "@/utils/sortPostsByDate";
import {getCollectionByName} from "@/utils/getCollectionByName";
import BlogPost from '@/layouts/BlogPost.astro'
import {comment} from "@/consts";
import {formatDate} from '@/utils/formatDate'
import {t} from '@/i18n/utils'
import getUrl from "@/utils/getUrl";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import type { FeedEntry } from "@/types/content";

export const getStaticPaths = (async () => {
  const posts = await getCollectionByName("feed");
  return posts.map((post) => ({
    params: {slug: post.slug},
    props: post,
  }));
}) satisfies GetStaticPaths;

const post = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const {Content} = await post.render();
const posts = await getCollectionByName("feed");
const sortPosts = sortPostsByDate(posts);

const postDate = post.data.date ? formatDate(post.data.date) : '';
const currentPostIndex = sortPosts.findIndex(
  (postItem) => postItem.slug === post.slug
);
let prevPostEntry: FeedEntry | undefined;
let nextPostEntry: FeedEntry | undefined;
if (sortPosts[currentPostIndex - 1]) {
  prevPostEntry = sortPosts[currentPostIndex - 1];
}
if (sortPosts[currentPostIndex + 1]) {
  nextPostEntry = sortPosts[currentPostIndex + 1];
}
---

<BlogPost frontmatter={post.data}>
  {
    post.data.title && (
      <header class="mb-4">
        <h1 class="break-all text-3xl font-bold leading-tight text-skin-base">
          {post.data.title}
        </h1>
      </header>
    )
  }
  {
    (
      <div class="flex items-center mb-2">
        {postDate &&
          <div class="flex items-center">
            <i class="ri-calendar-2-fill mr-1"/>
            <div class="tag">{postDate}</div>
          </div>}
        {comment.enable && comment.type === "waline" && comment.walineConfig.pageview && (
          <div class="divider-vertical"/>
          <a href="#" title="当前页面阅读量" class="flex items-center">
            <i class="ri-fire-fill mr-1"/>
            <span class="waline-pageview-count" data-path={getUrl('/') + post.collection + '/' + post.slug}/>
          </a>
          <div class="divider-vertical"/>
          <a href="#waline" title="当前页面评论数" class="flex items-center">
            <i class="ri-discuss-fill mr-1"/>
            <span class="waline-comment-count" data-path={getUrl('/') + post.collection + '/' + post.slug}/>
          </a>
        )}
      </div>
    )
  }
  <div class="divider-horizontal"></div>
  <article class="markdown-body scroll-smooth mb-4">
    <Content/>
  </article>
  <div class="divider-horizontal"></div>
  {
    (
      <div>
        {prevPostEntry ? (
          <a
            class="truncate  w-auto max-w-[40%] float-left"
            href={getUrl('/') + prevPostEntry.collection + '/' + prevPostEntry.slug}
            title={prevPostEntry.data.date ? formatDate(prevPostEntry.data.date) : t('feed.previous')}
          >
            <i class="ri-arrow-left-s-fill"/>
            {t('feed.previous')}
          </a>
        ) : (
          <div/>
        )}
        {nextPostEntry ? (
          <div class="flex item-center float-right w-auto max-w-[40%] text-right">
            <a
              class="truncate "
              href={getUrl('/') + nextPostEntry.collection + '/' + nextPostEntry.slug}
              title={nextPostEntry.data.date ? formatDate(nextPostEntry.data.date) : t('feed.next')}
            >
              {t('feed.next')}
            </a>
            <i class="ri-arrow-right-s-fill float-right"/>
          </div>
        ) : (
          <div/>
        )}
      </div>
    )
  }
  <div class="h-4"></div>
</BlogPost>
