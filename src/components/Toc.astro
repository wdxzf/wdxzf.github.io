---
import { t } from '@/i18n/utils';
import type { MarkdownHeading } from 'astro';
const { headings = null } = Astro.props as { headings?: MarkdownHeading[] | null };

const filtersHeadings = headings
  ? headings.filter((item: MarkdownHeading) => item.depth === 2 || item.depth === 3)
  : [];
---

{
  filtersHeadings.length > 0 && (
    <div
      id="toc"
      class="sticky my-4 top-20 toc-panel"
    >
      <div class="aside-widget">
        <i class="ri-list-check menu-icon"></i>
        {t('blog.tableOfContent')}
      </div>
      <ul class="toc-list flex flex-col max-w-full mt-4 max-h-[60vh] overflow-y-auto pr-1">
        {
          filtersHeadings.map((item: MarkdownHeading) => (
            <li
              class:list={[
                'toc-item',
                item.depth === 3 ? 'toc-depth-3' : 'toc-depth-2',
              ]}
            >
              <a title={item.text} href={`#${item.slug}`} class="toc-link truncate">
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>

      <style>
        .toc-panel {
          overflow: hidden;
          padding: 0;
          border: 1px solid rgba(var(--color-text), 0.045);
          border-radius: 0.5rem;
          background-color: rgba(var(--color-fill-secondary), 0.12);
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.014);
        }

        .toc-list {
          gap: 2px;
          margin-top: 0;
          padding: 0.42rem 0.52rem 0.56rem;
        }

        .toc-link {
          display: block;
          padding: 0.22rem 0.4rem 0.22rem 0.52rem;
          border-radius: 0.32rem;
          color: rgba(var(--color-text), 0.82);
          font-size: 0.8rem;
          line-height: 1.32;
          transition: color 0.2s ease, background-color 0.2s ease;
        }

        .toc-link:hover {
          color: rgb(var(--color-text-active));
          background-color: rgba(var(--color-text), 0.04);
        }

        .toc-depth-2 .toc-link {
          font-weight: 600;
        }

        .toc-depth-3 {
          margin-left: 0.42rem;
          border-left: 1px solid rgba(var(--color-text), 0.12);
        }

        .toc-depth-3 .toc-link {
          padding-left: 0.58rem;
          color: rgba(var(--color-text), 0.7);
          font-size: 0.76rem;
        }

        .active-heading {
          color: #cc7a00;
          font-weight: 600;
          background-color: rgba(var(--color-text-active), 0.075);
          position: relative;
        }

        .active-heading::before {
          content: '';
          position: absolute;
          left: 0;
          top: 50%;
          transform: translateY(-50%);
          width: 3px;
          height: 60%;
          border-radius: 999px;
          background-color: #cc7a00;
        }
      </style>

      <script>
        const anchors = document.querySelectorAll<HTMLElement>('h2, h3');
        const links = document.querySelectorAll<HTMLAnchorElement>('#toc> ul > li > a');

        const observerOptions = {
          root: null,
          rootMargin: '0px  0px -75% 0px',
          threshold: 0,
        };

        const callback = (entries: IntersectionObserverEntry[]) => {
          entries.forEach((entry: IntersectionObserverEntry) => {
            if (entry.isIntersecting) {
              const heading = entry.target as HTMLElement;
              let index = Array.from(anchors).indexOf(heading);
              if (index < 0 || index >= links.length) return;

              links.forEach((link) => {
                link.classList.remove('active-heading');
              });
              links[index].classList.add('active-heading');
            }
          });
        };

        if (anchors.length > 0 && links.length > 0) {
          const observer = new IntersectionObserver(callback, observerOptions);
          anchors.forEach((anchor) => {
            observer.observe(anchor);
          });
        }
      </script>
    </div>
  )
}
