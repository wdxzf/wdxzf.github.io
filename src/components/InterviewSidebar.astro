---
import getUrl from '@/utils/getUrl';
import {
  getInterviewPath,
  getVisibleInterviewEntries,
  sortInterviewEntries,
} from '@/utils/interview';

const { currentPath } = Astro.props as { currentPath: string };

const safeDecodePath = (value: string) => {
  try {
    return decodeURI(value);
  } catch {
    return value;
  }
};

const normalizePath = (value: string) => {
  if (!value || value === '/') {
    return '/';
  }

  return safeDecodePath(value).replace(/\/+$/, '');
};

const normalizedCurrentPath = normalizePath(currentPath);
const sortEntries = sortInterviewEntries(await getVisibleInterviewEntries());

const groups = sortEntries.reduce<Array<{title: string; items: Array<{title: string; href: string; active: boolean}>; active: boolean}>>((accumulator, entry) => {
  const [folder] = entry.slug.split('/');
  if (!folder) {
    return accumulator;
  }

  let group = accumulator.find((item) => item.title === folder);
  if (!group) {
    group = {title: folder, items: [], active: false};
    accumulator.push(group);
  }

  const href = getUrl(getInterviewPath(entry));
  const active = normalizePath(href) === normalizedCurrentPath;

  group.items.push({
    title: entry.data.title,
    href,
    active,
  });
  group.active ||= active;

  return accumulator;
}, []);
---

<aside class="interview-sidebar-shell flex flex-col py-2 lg:max-h-[calc(100vh-6rem)]">
  <button
    type="button"
    id="interview-sidebar-toggle"
    class="interview-sidebar-toggle"
    aria-controls="interview-sidebar-content"
    aria-expanded="true"
    aria-label="收起左侧索引"
    title="收起左侧索引"
  >
    <i class="ri-arrow-left-s-line interview-sidebar-toggle-icon" aria-hidden="true"></i>
  </button>

  <nav id="interview-sidebar-content" aria-label="Wiki sidebar" class="interview-sidebar-scroll lg:flex-1 lg:overflow-y-auto lg:pr-2">
    {
      groups.map((group) => (
        <details
          class:list={[
            'interview-folder',
            group.active && 'interview-folder-active',
          ]}
          data-folder={group.title}
          open={group.active}
        >
          <summary class="interview-folder-summary">
            <span class="interview-folder-title">{group.title}</span>
            <i class="ri-arrow-right-s-line interview-folder-icon" aria-hidden="true"></i>
          </summary>

          <ul class="mt-2 space-y-1.5">
            {
              group.items.map((item) => {
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'interview-sidebar-link',
                        item.active && 'interview-sidebar-link-active',
                      ]}
                      aria-current={item.active ? 'page' : undefined}
                      data-active={item.active ? 'true' : 'false'}
                    >
                      <span class="interview-sidebar-link-text">{item.title}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </details>
      ))
    }
  </nav>
</aside>

<style>
  .interview-sidebar-shell {
    min-width: 0;
    transition: padding 0.2s ease;
  }

  .interview-sidebar-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: 0.55rem;
    border: 1px solid rgba(var(--color-text), 0.1);
    border-radius: 0.45rem;
    background-color: rgba(var(--color-fill-secondary), 0.55);
    color: rgba(var(--color-text), 0.62);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .interview-sidebar-toggle:hover {
    color: rgb(var(--color-text-active));
    background-color: rgba(var(--color-text), 0.05);
  }

  .interview-sidebar-toggle-icon {
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  :global(.interview-sidebar-collapsed) .interview-sidebar-shell {
    align-items: center;
    padding-right: 0;
  }

  :global(.interview-sidebar-collapsed) .interview-sidebar-toggle {
    align-self: center;
    margin-bottom: 0;
  }

  :global(.interview-sidebar-collapsed) .interview-sidebar-toggle-icon {
    transform: rotate(180deg);
  }

  :global(.interview-sidebar-collapsed) .interview-sidebar-scroll {
    display: none;
  }

  .interview-folder {
    padding: 0.9rem 0;
    border-top: 1px solid rgba(var(--color-text), 0.08);
  }

  .interview-folder:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .interview-folder-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.15rem 0.45rem;
    cursor: pointer;
    list-style: none;
    color: rgba(var(--color-text), 0.94);
    font-size: 0.96rem;
    font-weight: 750;
    line-height: 1.45;
    transition: color 0.2s ease;
  }

  .interview-folder-summary::-webkit-details-marker {
    display: none;
  }

  .interview-folder-summary:hover {
    color: rgba(var(--color-text), 0.94);
  }

  .interview-folder-title {
    word-break: break-word;
  }

  .interview-folder-icon {
    flex: 0 0 auto;
    font-size: 1rem;
    color: rgba(var(--color-text), 0.62);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .interview-folder-active .interview-folder-summary,
  .interview-folder[open] .interview-folder-icon {
    color: rgba(var(--color-text), 0.94);
  }

  .interview-folder-active .interview-folder-summary {
    color: rgba(var(--color-text), 0.94);
  }

  .interview-folder[open] .interview-folder-icon {
    transform: rotate(90deg);
  }

  .interview-sidebar-link {
    display: block;
    border-radius: 0.35rem;
    padding: 0.5rem 0.65rem 0.5rem 1rem;
    color: rgba(var(--color-text), 0.74);
    white-space: normal;
    word-break: break-word;
    font-size: 0.94rem;
    line-height: 1.5;
    position: relative;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    border: 0;
  }

  .interview-sidebar-link-text {
    display: block;
  }

  .interview-sidebar-link:hover {
    color: rgba(var(--color-text), 0.9);
    background-color: rgba(var(--color-text), 0.025);
  }

  .interview-sidebar-link-active {
    background-color: rgba(var(--color-text-active), 0.08);
    color: rgba(var(--color-text-active), 0.98);
    font-weight: 700;
    padding-left: 1rem;
    box-shadow: inset 2px 0 0 rgba(var(--color-text-active), 0.84);
  }

  .interview-sidebar-link-active .interview-sidebar-link-text {
    color: inherit;
  }

  .interview-sidebar-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--color-text), 0.18) transparent;
  }

  .interview-sidebar-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .interview-sidebar-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .interview-sidebar-scroll::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background-color: rgba(var(--color-text), 0.16);
  }
</style>

<script>
  const INTERVIEW_SIDEBAR_STATE_KEY = 'interview-sidebar-open-folders';

  const readOpenFolders = () => {
    try {
      const raw = localStorage.getItem(INTERVIEW_SIDEBAR_STATE_KEY);
      const value = raw ? JSON.parse(raw) : [];
      return Array.isArray(value) ? value : [];
    } catch {
      return [];
    }
  };

  const writeOpenFolders = (folders: string[]) => {
    try {
      localStorage.setItem(INTERVIEW_SIDEBAR_STATE_KEY, JSON.stringify(folders));
    } catch {
      // Ignore storage failures and keep sidebar usable.
    }
  };

  const scrollActiveInterviewSidebarLinkIntoView = (behavior: ScrollBehavior = 'auto') => {
    const scrollContainer = document.querySelector<HTMLElement>('#interview-sidebar-content');
    const activeLink = scrollContainer?.querySelector<HTMLElement>('.interview-sidebar-link-active');

    if (!scrollContainer || !activeLink || getComputedStyle(scrollContainer).display === 'none') {
      return;
    }

    requestAnimationFrame(() => {
      const containerRect = scrollContainer.getBoundingClientRect();
      const activeRect = activeLink.getBoundingClientRect();
      const isAbove = activeRect.top < containerRect.top;
      const isBelow = activeRect.bottom > containerRect.bottom;

      if (!isAbove && !isBelow) {
        return;
      }

      const offset =
        activeRect.top - containerRect.top - containerRect.height / 2 + activeRect.height / 2;

      scrollContainer.scrollTo({
        top: scrollContainer.scrollTop + offset,
        behavior,
      });
    });
  };

  const initializeInterviewSidebarState = () => {
    const folders = document.querySelectorAll<HTMLDetailsElement>('.interview-folder');
    if (folders.length === 0) {
      return;
    }

    const storedFolders = new Set(readOpenFolders());

    folders.forEach((folder) => {
      const folderName = folder.dataset.folder;
      const hasActivePage = folder.querySelector('.interview-sidebar-link-active');
      if (!folderName) {
        return;
      }

      folder.open = hasActivePage ? true : storedFolders.has(folderName);

      folder.addEventListener('toggle', () => {
        const nextFolders = new Set(readOpenFolders());
        if (folder.open) {
          nextFolders.add(folderName);
        } else {
          nextFolders.delete(folderName);
        }
        writeOpenFolders(Array.from(nextFolders));
      });
    });

    scrollActiveInterviewSidebarLinkIntoView();
  };

  document.addEventListener('astro:page-load', initializeInterviewSidebarState);
  document.addEventListener('interview-sidebar:expanded', () => {
    scrollActiveInterviewSidebarLinkIntoView('smooth');
  });
  initializeInterviewSidebarState();
</script>
