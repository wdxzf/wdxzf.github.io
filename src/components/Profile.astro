---
import {site, infoLinks} from "@/consts";
import getUrl from "@/utils/getUrl";
const activeInfoLinks = infoLinks.filter((infoItem) => infoItem.outlink);
---

<div class="shadow-lg rounded-lg min-h-0 w-auto flex flex-col items-center justify-center bg-skin-card px-3 py-4">
  <img class="avatar mb-3" src={site.avatar.startsWith('http') ? site.avatar : getUrl(site.avatar)} alt="avatar"/>
    <div class="mb-2 text-center leading-7">{site.motto}</div>
  <div class="flex items-center justify-center flex-nowrap whitespace-nowrap">
    {
      activeInfoLinks.map((infoItem) => (
        <a
          class="social-link"
          aria-label={infoItem.name}
          href={infoItem.outlink}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class={infoItem.icon + " text-2xl cursor-pointer"}/>
          <span class="social-link-tooltip">{infoItem.name}</span>
        </a>
      ))
    }
  </div>
</div>
