---
const { date, index } = Astro.props;
---

<feed-post-date class={date ? "mr-2" : ""} data-date={date} data-index={index}>
  <span class="postTimeEle"></span>
</feed-post-date>

<script>
  import dayjs from "dayjs";
  import relativeTime from "dayjs/plugin/relativeTime";
  import "dayjs/locale/zh-cn";
  import {t} from '../i18n/utils'
  import {config} from "../consts";

  dayjs.extend(relativeTime);
  dayjs.locale(config.lang || 'en');
  class FeedPostDate extends HTMLElement {
    constructor() {
      super();
      const date = this.dataset.date;
      const index = Number(this.dataset.index);

      const timeSpan = document.querySelectorAll<HTMLElement>(".postTimeEle");
      const postDateFromNow = date ? dayjs(date).fromNow() : dayjs().format("YYYY-MM-DD");
      if (Number.isInteger(index) && timeSpan[index]) {
        timeSpan[index].innerHTML = `${t('feed.publishedIn')}：${postDateFromNow}`;
      }
    }
  }
  customElements.define("feed-post-date", FeedPostDate);
</script>
