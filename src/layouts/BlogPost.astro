---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Profile from '@/components/Profile.astro';
import Comment from '@/components/Comment.astro';
import Toc from '@/components/Toc.astro';
import MobileToc from '@/components/MobileToc.astro';
import { comment, config } from '@/consts';
import ScrollToTop from '@/components/ScrollToTop.astro';
import { t } from '@/i18n/utils';
import getUrl from '@/utils/getUrl';
import '@fancyapps/ui/dist/fancybox/fancybox.css';

const {
  frontmatter = {
    comment: false,
    donate: false,
    toc: false,
    mathjax: false,
    mermaid: false,
  },
  headings,
} = Astro.props;
---

<html lang={config.lang}>
  <BaseHead
    title={frontmatter.title}
    description={frontmatter.description}
    mathjax={frontmatter.mathjax}
    mermaid={frontmatter.mermaid}
    ogImage={frontmatter.ogImage}
    type="article"
    publishedTime={frontmatter.date}
    modifiedTime={frontmatter.lastModified}
  />

  <body class="bg-skin-secondary">
    <Header />
    <main
      class="container relative min-h-full p-4 pt-20 pb-32 text-skin-base"
      id="app"
    >
      <div class="grid grid-cols-4 gap-8">
        <div class="col-span-4 space-y-4 xl:col-span-3 first:space-y-2">
          <a
            id="back-button"
            class="flex items-center outline-none cursor-pointer text-md hover:text-skin-active"
            style="background-color: inherit;"
            href={getUrl('/blog/1')}
            onclick={`if (window.history.length > 1) { window.history.back(); return false; }`}
          >
            <i class="mr-2 ri-arrow-left-line"></i>
            <span>{t('home.goBack')}</span>
          </a>
          <slot />
          {frontmatter.comment && comment.enable && <Comment />}
        </div>
        <div class="relative hidden col-span-1 xl:block">
          <Profile />
          {frontmatter.toc && <Toc headings={headings} />}
        </div>
        {frontmatter.toc && <MobileToc headings={headings} />}
        <ScrollToTop />
      </div>
      <Footer />
    </main>
  </body>
</html>

<script>
  const shouldDecorateExternalLink = (link: HTMLAnchorElement) => {
    const href = link.getAttribute('href');

    if (
      !href ||
      href.startsWith('#') ||
      href.startsWith('mailto:') ||
      href.startsWith('tel:')
    ) {
      return false;
    }

    const resolvedUrl = new URL(href, window.location.href);
    return resolvedUrl.origin !== window.location.origin;
  };

  const initializeLightbox = async () => {
    try {
      const { Fancybox } = await import('@fancyapps/ui/dist/fancybox/fancybox.esm.js');
      Fancybox.bind('[data-fancybox]');
    } catch (error) {
      console.error('Failed to initialize Fancybox.', error);
    }
  };

  const markdownBody = document.querySelector('.markdown-body');
  if (markdownBody) {
    const images = markdownBody.querySelectorAll<HTMLImageElement>('img');
    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry: IntersectionObserverEntry) => {
        if (entry.isIntersecting) {
          const image = entry.target as HTMLImageElement;
          const data_src = image.getAttribute('data-src');
          const data_alt = image.getAttribute('data-alt');
          image.setAttribute('data-fancybox', 'gallery');
          if (data_src) {
            image.setAttribute('src', data_src);
          }
          if (data_alt) {
            image.setAttribute('alt', data_alt);
          }
          observer.unobserve(image);
        }
      });
    };

    const observer = new IntersectionObserver(callback);
    images.forEach((image) => {
      image.setAttribute('data-fancybox', 'gallery');
      observer.observe(image);
    });

    if (images.length > 0) {
      initializeLightbox();
    }

    const links = markdownBody.querySelectorAll<HTMLAnchorElement>('a');
    for (var i = 0; i < links.length; i++) {
      let names = links[i].getAttributeNames();
      if (
        !names.includes('data-footnote-backref') &&
        !names.includes('data-footnote-ref') &&
        shouldDecorateExternalLink(links[i])
      ) {
        links[i].setAttribute('target', '_blank');
        links[i].setAttribute('rel', 'nofollow noopener noreferrer');
      }
    }

    const spoilers = markdownBody.querySelectorAll<HTMLElement>('[data-spoiler]');
    const setSpoilerState = (element: HTMLElement, revealed: boolean) => {
      element.setAttribute('data-revealed', String(revealed));
      element.setAttribute('aria-pressed', String(revealed));
    };

    spoilers.forEach((spoiler) => {
      setSpoilerState(spoiler, spoiler.getAttribute('data-revealed') === 'true');

      spoiler.addEventListener('click', () => {
        setSpoilerState(spoiler, spoiler.getAttribute('data-revealed') !== 'true');
      });

      spoiler.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          setSpoilerState(spoiler, spoiler.getAttribute('data-revealed') !== 'true');
        }

        if (event.key === 'Escape') {
          setSpoilerState(spoiler, false);
          spoiler.blur();
        }
      });
    });
  }
</script>
