---
import { t } from '@/i18n/utils';
import type { MarkdownHeading } from 'astro';

const { headings = null } = Astro.props as { headings?: MarkdownHeading[] | null };

const filteredHeadings = headings
  ? headings.filter((item: MarkdownHeading) => item.depth === 2 || item.depth === 3)
  : [];
---

{
  filteredHeadings.length > 0 && (
    <div id="interview-toc" class="sticky top-20 py-2 pl-7">
      <div class="aside-widget">
        <i class="ri-list-check menu-icon"></i>
        {t('blog.tableOfContent')}
      </div>

      <ul class="interview-toc-list mt-4 max-h-[70vh] overflow-y-auto pr-1">
        {
          filteredHeadings.map((item: MarkdownHeading) => (
            <li
              class:list={[
                'interview-toc-item',
                item.depth === 3 ? 'interview-toc-depth-3' : 'interview-toc-depth-2',
              ]}
            >
              <a title={item.text} href={`#${item.slug}`} class="interview-toc-link">
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>

      <style>
        #interview-toc {
          border-left: 1px solid rgba(var(--color-text), 0.1);
        }

        .interview-toc-list {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
        }

        .interview-toc-link {
          display: block;
          color: rgba(var(--color-text), 0.68);
          line-height: 1.6;
          transition: color 0.2s ease;
        }

        .interview-toc-link:hover {
          color: rgba(var(--color-text), 0.92);
        }

        .interview-toc-depth-2 .interview-toc-link {
          font-weight: 700;
          color: rgba(var(--color-text), 0.84);
        }

        .interview-toc-depth-3 {
          margin-left: 0.9rem;
          padding-left: 0.9rem;
          border-left: 1px dashed rgba(var(--color-text), 0.14);
        }

        .interview-toc-depth-3 .interview-toc-link {
          font-size: 0.95rem;
          color: rgba(var(--color-text), 0.58);
        }

        .interview-toc-link.active-heading {
          color: rgba(var(--color-text), 0.96);
          font-weight: 700;
        }
      </style>

      <script>
        const anchors = document.querySelectorAll<HTMLElement>('h2, h3');
        const links = document.querySelectorAll<HTMLAnchorElement>('#interview-toc .interview-toc-link');

        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -75% 0px',
          threshold: 0,
        };

        const callback = (entries: IntersectionObserverEntry[]) => {
          entries.forEach((entry: IntersectionObserverEntry) => {
            if (!entry.isIntersecting) {
              return;
            }

            const heading = entry.target as HTMLElement;
            const index = Array.from(anchors).indexOf(heading);
            if (index < 0 || index >= links.length) {
              return;
            }

            links.forEach((link) => {
              link.classList.remove('active-heading');
            });

            links[index].classList.add('active-heading');
          });
        };

        if (anchors.length > 0 && links.length > 0) {
          const observer = new IntersectionObserver(callback, observerOptions);
          anchors.forEach((anchor) => {
            observer.observe(anchor);
          });
        }
      </script>
    </div>
  )
}
