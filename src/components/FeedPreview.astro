---
import FeedPostDate from "./FeedPostDate.astro";
import getUrl from "@/utils/getUrl";
import {getPostPlainText, truncateText} from "@/utils/getPostPlainText";
import {config} from "@/consts";

const {data, body, slug} = Astro.props.post;
const {index} = Astro.props;

const plainText = getPostPlainText(body);
const explicitTitle = data.title?.trim() ?? '';
const hasTitle = Boolean(explicitTitle);
const sentenceSegments = plainText
  .split(/(?<=[。！？.!?])\s+/)
  .map((item) => item.trim())
  .filter(Boolean);
const previewSource = explicitTitle
  ? plainText
  : sentenceSegments.join(' ') || plainText;
const preview = previewSource ? truncateText(previewSource, explicitTitle ? 140 : 96) : '';
const isCompact = !preview || preview.length <= 72;

const publishedDate = data.date
  ? new Intl.DateTimeFormat(config.lang, {
      year: 'numeric',
      month: 'long',
      day: '2-digit',
    }).format(new Date(data.date))
  : '';
const publishedTime = data.date
  ? new Intl.DateTimeFormat(config.lang, {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    }).format(new Date(data.date))
  : '';
---

<article
  class:list={[
    'feed-entry',
    isCompact && 'feed-entry--compact',
    hasTitle ? 'feed-entry--titled' : 'feed-entry--note',
  ]}
>
  <a class="feed-entry-card" href={getUrl("/feed/") + slug}>
    <div class="feed-entry-meta">
      <span class="feed-entry-meta-item">
        <i class="ri-calendar-line"></i>
        <time datetime={String(data.date)}>{publishedDate}</time>
      </span>
      {
        publishedTime && (
          <span class="feed-entry-meta-item">
            <i class="ri-time-line"></i>
            <span>{publishedTime}</span>
          </span>
        )
      }
      <span class="feed-entry-meta-item feed-entry-meta-item--relative">
        <FeedPostDate date={data.date} index={index}/>
      </span>
    </div>

    <div class="feed-entry-body">
      {explicitTitle && <h2 class="feed-entry-title">{explicitTitle}</h2>}
      {preview && <p class="feed-entry-summary">{preview}</p>}
    </div>
  </a>
</article>
