---
import { t } from '@/i18n/utils';
import type { MarkdownHeading } from 'astro';

const { headings = null } = Astro.props as { headings?: MarkdownHeading[] | null };

const filteredHeadings = headings
  ? headings.filter((item: MarkdownHeading) => item.depth === 2 || item.depth === 3)
  : [];
---

{
  filteredHeadings.length > 0 && (
    <div
      id="interview-toc"
      class="sticky px-3 py-3 my-4 rounded-lg shadow-lg bg-skin-card top-20 interview-toc-panel"
    >
      <div class="aside-widget">
        <i class="ri-list-check menu-icon"></i>
        {t('blog.tableOfContent')}
      </div>

      <ul class="interview-toc-list flex flex-col max-w-full mt-4 max-h-[60vh] overflow-y-auto pr-1">
        {
          filteredHeadings.map((item: MarkdownHeading) => (
            <li
              class:list={[
                'interview-toc-item',
                item.depth === 3 ? 'interview-toc-depth-3' : 'interview-toc-depth-2',
              ]}
            >
              <a title={item.text} href={`#${item.slug}`} class="interview-toc-link truncate">
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>

      <style>
        .interview-toc-panel {
          border: 1px solid rgba(var(--color-text), 0.08);
        }

        .interview-toc-list {
          gap: 8px;
          scrollbar-width: thin;
          scrollbar-color: rgba(var(--color-text), 0.16) transparent;
        }

        .interview-toc-list::-webkit-scrollbar {
          width: 4px;
        }

        .interview-toc-list::-webkit-scrollbar-track {
          background: transparent;
        }

        .interview-toc-list::-webkit-scrollbar-thumb {
          border-radius: 999px;
          background-color: rgba(var(--color-text), 0.14);
        }

        .interview-toc-link {
          display: block;
          padding: 6px 10px 6px 12px;
          border-radius: 6px;
          color: rgba(var(--color-text), 0.85);
          line-height: 1.5;
          transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
        }

        .interview-toc-link:hover {
          color: rgb(var(--color-text-active));
          background-color: rgba(var(--color-text), 0.06);
          transform: translateX(1px);
        }

        .interview-toc-depth-2 .interview-toc-link {
          font-weight: 600;
        }

        .interview-toc-depth-3 {
          margin-left: 10px;
          border-left: 1px dashed rgba(var(--color-text), 0.2);
        }

        .interview-toc-depth-3 .interview-toc-link {
          font-size: 0.95rem;
          color: rgba(var(--color-text), 0.75);
          padding-left: 12px;
        }

        .interview-toc-link.active-heading {
          color: #cc7a00;
          font-weight: 600;
          background-color: rgba(var(--color-text), 0.08);
          position: relative;
        }

        .interview-toc-link.active-heading::before {
          content: '';
          position: absolute;
          left: 0;
          top: 50%;
          transform: translateY(-50%);
          width: 4px;
          height: 60%;
          border-radius: 999px;
          background-color: #cc7a00;
        }
      </style>

      <script>
        const anchors = document.querySelectorAll<HTMLElement>('h2, h3');
        const links = document.querySelectorAll<HTMLAnchorElement>('#interview-toc .interview-toc-link');

        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -75% 0px',
          threshold: 0,
        };

        const callback = (entries: IntersectionObserverEntry[]) => {
          entries.forEach((entry: IntersectionObserverEntry) => {
            if (!entry.isIntersecting) {
              return;
            }

            const heading = entry.target as HTMLElement;
            const index = Array.from(anchors).indexOf(heading);
            if (index < 0 || index >= links.length) {
              return;
            }

            links.forEach((link) => {
              link.classList.remove('active-heading');
            });

            links[index].classList.add('active-heading');
          });
        };

        if (anchors.length > 0 && links.length > 0) {
          const observer = new IntersectionObserver(callback, observerOptions);
          anchors.forEach((anchor) => {
            observer.observe(anchor);
          });
        }
      </script>
    </div>
  )
}
