---
import IndexPage from "@/layouts/IndexPage.astro";
import { config } from "@/consts";
import {t} from '@/i18n/utils'

const includeContent = config.search.includeContent;
---
<IndexPage
  title={t('search.search')}
  description="搜索博客文章标题、摘要和正文内容。"
>
  <section class="search-shell">
    <aside class="search-hero rounded-2xl p-5 md:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <label for="search" class="text-2xl font-semibold text-skin-base">
            {t('search.search')}
          </label>
          <p id="search-help" class="mt-2 text-sm leading-6 text-skin-dodge">
            {t('search.hint')}
          </p>
        </div>
        <div class="search-shortcut rounded-full border border-skin-dodge border-opacity-40 px-3 py-1 text-xs text-skin-dodge">
          /
        </div>
      </div>

      <div class="relative mt-5">
        <span class="absolute inset-y-0 flex items-center pl-2 opacity-75">
          <i class="ri-search-line text-skin-active ml-1"></i>
        </span>
        <input
          required
          maxlength="24"
          id="search"
          class="block w-full rounded-2xl border border-opacity-40 bg-skin-fill text-skin-base py-3 pl-10 pr-3 placeholder:italic placeholder:text-opacity-75 focus:border-skin-accent focus:outline-none"
          placeholder={t('search.placeholder')}
          type="search"
          name="search"
          aria-describedby="search-help"
          autofocus
        />
      </div>
    </aside>

    <p id="searchReadout" class="mt-4 text-sm text-skin-dodge"></p>
    <section aria-label="Search Results" class="mt-2">
      <div id="resultsList"></div>
    </section>
  </section>
</IndexPage>
<script define:vars={{ includeContent }}>
  import {t} from '../i18n/utils'
  import Fuse, { type IFuseOptions, type FuseResult } from "fuse.js";
  import {formatDate} from '../utils/formatDate'
  import {dealLabel} from "../utils/dealLabel";
  import getUrl from "../utils/getUrl";

  type SearchDocument = {
    slug: string;
    title: string;
    description: string;
    date: string;
    category: string[] | string | null;
    tags: string[] | string | null;
    content?: string;
    excerpt: string;
  };

  let SEARCH_DATA: SearchDocument[] | null = null;
  let FUSE_INSTANCE: Fuse<SearchDocument> | null = null;
  let searchTimeoutId: number | undefined;
  const keys: IFuseOptions<SearchDocument>['keys'] = [
    {
      name: 'title',
      weight: 1.3
    },
    {
      name: 'description',
      weight: 1
    },
    {
      name: 'excerpt',
      weight: 0.9
    },
    {
      name: 'tags',
      weight: 0.6
    },
    {
      name: 'category',
      weight: 0.5
    }
  ];

  if (includeContent) {
    keys.push({
      name: 'content',
      weight: 0.7
    });
  }

  const FUSE_OPTIONS: IFuseOptions<SearchDocument> = {
    includeScore: true,
    includeMatches: true,
    shouldSort: true,
    threshold: 0.5,
    keys
  }

  const search = document.querySelector<HTMLInputElement>('#search');
  const searchReadout = document.querySelector<HTMLElement>('#searchReadout');
  const resultsList = document.querySelector<HTMLDivElement>('#resultsList');
  const loadingMarkup = `
    <div class="search-empty-state rounded-lg px-4 py-5 text-sm text-skin-dodge">
      <div class="inline-flex items-center gap-2">
        <i class="ri-loader-4-line animate-spin text-skin-active"></i>
        <span>${t('search.search')}</span>
      </div>
    </div>
  `;

  if (!search || !searchReadout || !resultsList) {
    throw new Error('Search page elements not found.');
  }

  const searchInput = search;
  const searchReadoutEl = searchReadout;
  const resultsListEl = resultsList;

  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = (new URLSearchParams(window.location.search).get('q') || '').trim();
    fetchSearchResults(urlParams);
    searchInput.value = urlParams;
  });

  window.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) {
      return;
    }

    const activeTagName = document.activeElement?.tagName?.toLowerCase();
    if (activeTagName === 'input' || activeTagName === 'textarea') {
      return;
    }

    event.preventDefault();
    searchInput.focus();
    searchInput.select();
  });

  searchInput.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      searchInput.value = '';
      fetchSearchResults('');
      updateSearchPageUrl('');
    }
  });

  searchInput.addEventListener("input", () => {
    const searchTerm = searchInput.value.trim();

    window.clearTimeout(searchTimeoutId);
    searchTimeoutId = window.setTimeout(() => {
      fetchSearchResults(searchTerm);
      updateSearchPageUrl(searchTerm);
    }, 120);
  });

  function updateReadout(length: number | null) {
    if (typeof length === 'number') {
      searchReadoutEl.innerHTML = `<div class="my-3">${t('search.searchLabelOne')}<span class="px-2 font-bold text-skin-active">${length}</span>${t('search.searchLabelTwo')}</div>`
    } else {
      searchReadoutEl.innerHTML = "";
    }
  }

  function updateSearchPageUrl(search: string) {
    const url = new URL(window.location.href);
    if (search) {
      url.searchParams.set("q", search);
    } else {
      url.searchParams.delete("q");
    }
    window.history.replaceState(null, '', url);
  }

  function escapeRegExp(value: string) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function createHighlightedFragment(text: string, searchTerm: string) {
    const fragment = document.createDocumentFragment();

    if (!searchTerm) {
      fragment.append(document.createTextNode(text));
      return fragment;
    }

    const reg = new RegExp(escapeRegExp(searchTerm), 'gi');
    let lastIndex = 0;

    for (const match of text.matchAll(reg)) {
      const [matchedText] = match;
      const index = match.index ?? 0;

      if (index > lastIndex) {
        fragment.append(document.createTextNode(text.slice(lastIndex, index)));
      }

      const highlight = document.createElement('mark');
      highlight.className = 'search-highlight';
      highlight.textContent = matchedText;
      fragment.append(highlight);
      lastIndex = index + matchedText.length;
    }

    if (lastIndex < text.length) {
      fragment.append(document.createTextNode(text.slice(lastIndex)));
    }

    return fragment;
  }

  function getSnippet(item: SearchDocument, searchTerm: string) {
    const normalizedSearch = searchTerm.toLowerCase();
    const snippetSources = [item.description, item.content, item.excerpt].filter(Boolean);

    for (const source of snippetSources) {
      const sourceText = source.trim();
      const foundIndex = sourceText.toLowerCase().indexOf(normalizedSearch);

      if (foundIndex >= 0) {
        const start = Math.max(foundIndex - 48, 0);
        const end = Math.min(foundIndex + normalizedSearch.length + 96, sourceText.length);
        const prefix = start > 0 ? '...' : '';
        const suffix = end < sourceText.length ? '...' : '';

        return `${prefix}${sourceText.slice(start, end).trim()}${suffix}`;
      }
    }

    return item.excerpt || '';
  }

  function createMetaLink(iconClass: string, href: string, text: string) {
    const link = document.createElement('a');
    link.className = 'mr-3 flex items-center hover:text-skin-active';
    link.href = href;

    const icon = document.createElement('i');
    icon.className = `${iconClass} mr-1`;
    link.append(icon);
    link.append(document.createTextNode(text));

    return link;
  }

  function renderResults(results: FuseResult<SearchDocument>[], searchTerm: string) {
    resultsListEl.replaceChildren();

    if (results.length === 0) {
      const emptyState = document.createElement('div');
      emptyState.className = 'search-empty-state rounded-lg px-5 py-6 text-sm text-skin-dodge';
      emptyState.textContent = t('search.empty');
      resultsListEl.append(emptyState);
      return;
    }

    const fragment = document.createDocumentFragment();

    results.forEach((result) => {
      const {title, date, slug, category, tags} = result.item;
      const article = document.createElement('article');
      article.className = 'search-result-card my-4 rounded-2xl p-5 md:p-6';

      const titleLink = document.createElement('a');
      titleLink.className = 'text-xl font-semibold leading-8 transition-colors hover:text-skin-active';
      titleLink.href = getUrl('/blog/') + slug;
      titleLink.append(createHighlightedFragment(title, searchTerm));
      article.append(titleLink);

      const meta = document.createElement('div');
      meta.className = 'my-3 flex flex-wrap items-center gap-y-2 text-sm text-skin-dodge';

      const dateNode = document.createElement('div');
      dateNode.className = 'mr-3 flex items-center';
      dateNode.innerHTML = `<i class="ri-calendar-2-fill mr-1"></i>${formatDate(date)}`;
      meta.append(dateNode);

      dealLabel(category)
        .filter((item) => item !== 'uncategorized')
        .forEach((categoryName) => {
          meta.append(
            createMetaLink(
              'ri-folder-3-line',
              getUrl('/category/') + categoryName,
              categoryName
            )
          );
        });

      dealLabel(tags).forEach((tagName) => {
        meta.append(
          createMetaLink('ri-hashtag', getUrl('/tags/') + tagName, tagName)
        );
      });

      article.append(meta);

      const description = document.createElement('p');
      description.className = 'break-all leading-7 text-skin-dodge';
      description.append(createHighlightedFragment(getSnippet(result.item, searchTerm), searchTerm));
      article.append(description);

      fragment.append(article);
    });

    resultsListEl.append(fragment);
  }

  async function ensureSearchIndex() {
    if (SEARCH_DATA) {
      return;
    }

    const res = await fetch(getUrl("/search.json"));
    if (!res.ok) {
      throw new Error("Something went wrong...Please try again.");
    }

    SEARCH_DATA = await res.json();
    if (SEARCH_DATA && !FUSE_INSTANCE) {
      FUSE_INSTANCE = new Fuse(SEARCH_DATA, FUSE_OPTIONS);
    }
  }

  async function fetchSearchResults(search: string) {
    if (!search) {
      updateReadout(null);
      renderIdleState();
      return;
    }

    resultsListEl.innerHTML = loadingMarkup;

    try {
      await ensureSearchIndex();
    } catch (e) {
      console.log(e);
      return;
    }

    if (!FUSE_INSTANCE) return;
    const searchResults = FUSE_INSTANCE.search(search);
    updateReadout(searchResults.length);
    renderResults(searchResults, search);
  }

  function renderIdleState() {
    resultsListEl.innerHTML = `
      <div class="search-empty-state rounded-2xl px-5 py-6">
        <div class="flex items-start gap-3">
          <i class="ri-compass-3-line mt-1 text-lg text-skin-active"></i>
          <div>
            <p class="text-base font-medium text-skin-base">${t('search.search')}</p>
            <p class="mt-2 text-sm leading-6 text-skin-dodge">
              输入文章标题、摘要、标签或分类开始搜索。按 <span class="search-inline-key">/</span> 可快速聚焦搜索框。
            </p>
          </div>
        </div>
      </div>
    `;
  }
</script>
